* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: #e2e8f0;
  background: #07111f;
  line-height: 1.5;
  font-weight: 400;
}

body {
  margin: 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #07111f 0%, #0f172a 100%);
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

#root {
  min-height: 100vh;
}

.app-shell {
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr);
  min-height: 100vh;
}

.sidebar {
  background: rgba(15, 23, 42, 0.92);
  border-right: 1px solid rgba(148, 163, 184, 0.12);
  padding: 28px 20px;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 28px;
}

.brand-logo {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: linear-gradient(135deg, #38bdf8, #8b5cf6);
  font-weight: 800;
  color: white;
}

.eyebrow {
  margin: 0 0 6px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #7dd3fc;
  font-size: 10px;
}

h1,
h2,
h3,
h4,
p {
  margin: 0;
}

h1 {
  font-size: 1.2rem;
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nav-item {
  border: 1px solid transparent;
  background: transparent;
  padding: 12px 14px;
  color: #cbd5e1;
  border-radius: 10px;
  text-align: left;
  transition: 0.2s ease;
}

.nav-item.is-active,
.nav-item:hover {
  background: rgba(59, 130, 246, 0.12);
  border-color: rgba(96, 165, 250, 0.25);
  color: #f8fafc;
}

.main-panel {
  padding: 28px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22px;
}

.topbar h2 {
  font-size: 2rem;
}

.primary-button {
  background: linear-gradient(135deg, #3b82f6, #8b5cf6);
  color: white;
  border: none;
  border-radius: 12px;
  padding: 10px 16px;
  font-weight: 600;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 22px;
}

.stat-card {
  background: rgba(15, 23, 42, 0.78);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 16px;
  padding: 18px 20px;
}

.stat-card span,
.stat-card small {
  display: block;
  color: #94a3b8;
}

.stat-card strong {
  display: block;
  margin: 12px 0 8px;
  font-size: 2rem;
}

.stat-card.success strong { color: #34d399; }
.stat-card.warning strong { color: #fbbf24; }
.stat-card.danger strong { color: #f87171; }

.content-grid {
  display: grid;
  grid-template-columns: minmax(320px, 420px) minmax(0, 1fr);
  gap: 18px;
}

.list-panel,
.detail-panel {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 18px;
  padding: 18px;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}

.panel-header input {
  width: 100%;
  max-width: 220px;
  border-radius: 10px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(15, 23, 42, 0.9);
  color: #e2e8f0;
  padding: 10px 12px;
}

.shipment-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.shipment-item {
  width: 100%;
  background: rgba(15, 23, 42, 0.86);
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 12px;
  padding: 14px;
  color: #e2e8f0;
  text-align: left;
}

.shipment-item.active {
  border-color: rgba(96, 165, 250, 0.6);
  background: rgba(30, 41, 59, 0.95);
}

.shipment-topline,
.shipment-meta,
.shipment-progress,
.detail-header,
.detail-grid,
.route-box,
.event-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.shipment-meta {
  margin: 10px 0 6px;
  color: #94a3b8;
  font-size: 0.8rem;
}

.shipment-route {
  color: #cbd5e1;
  font-size: 0.8rem;
}

.shipment-progress {
  margin-top: 12px;
}

.bar {
  flex: 1;
  height: 8px;
  background: rgba(148, 163, 184, 0.18);
  border-radius: 99px;
  overflow: hidden;
}

.bar span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(135deg, #22c55e, #38bdf8);
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.72rem;
  font-weight: 700;
}

.detail-header {
  margin-bottom: 18px;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px 18px;
  margin-bottom: 18px;
}

.detail-grid label,
.route-box p {
  display: block;
  color: #94a3b8;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 6px;
}

.route-box {
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 18px;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 18px;
}

.timeline-item {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(15, 23, 42, 0.7);
  border-radius: 10px;
  padding: 10px 12px;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: linear-gradient(135deg, #38bdf8, #8b5cf6);
  box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2);
}

.timeline-item small,
.event-item small,
.event-item p {
  display: block;
  color: #94a3b8;
}

.event-panel {
  margin-top: 10px;
}

.event-panel h4 {
  margin-bottom: 12px;
}

.event-item {
  border-left: 2px solid rgba(59, 130, 246, 0.7);
  padding: 10px 0 10px 14px;
  margin-bottom: 12px;
}

.event-item p {
  margin: 6px 0;
}

.loading,
.empty-state {
  padding: 22px 10px;
  color: #94a3b8;
  text-align: center;
}

@media (max-width: 980px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    border-right: none;
    border-bottom: 1px solid rgba(148, 163, 184, 0.12);
  }

  .stats-grid,
  .content-grid,
  .detail-grid {
    grid-template-columns: 1fr;
  }
}
